node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Vercel project link metadata (project/org IDs) — not a secret, but
# deployment-account-specific and not something to track in source control.
.vercel/
# Auto-regenerated by `next dev` every run (apps/web/AGENTS.md -> generate-agent-files.js);
# framework noise, not source — not worth tracking or diffing.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Build output
dist/
build/
*.tsbuildinfo

# Environment — real secrets must never be committed.
.env
.env.*
!.env.example

# Evidence capture written at runtime. Sanitized fixtures that are meant to be
# committed live under packages/*/fixtures/ and are tracked explicitly.
# Raw live-validation artifacts stay local until curated deliberately (they hold
# third-party public addresses and full sponsor payloads). Credentials are never in them.
**/evidence/runtime/*
!**/evidence/runtime/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
