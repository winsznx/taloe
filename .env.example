# Taloe environment template.
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
#
# Every value in this file is server-side only. Nothing here may be prefixed
# with NEXT_PUBLIC_ except the variables explicitly marked as public below.

# ---------------------------------------------------------------------------
# Binance Web3 API credentials (server-side only)
# Obtain from https://web3.binance.com/en/dev-portal/project
# ---------------------------------------------------------------------------
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Base URL including the mandatory /build path prefix.
# The signed requestPath must also carry /build — see internal/sponsor/API_MATRIX.md.
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# Allowed clock deviation in ms (default 5000, max 60000 per current docs).
BINANCE_WEB3_RECV_WINDOW_MS=5000

# ---------------------------------------------------------------------------
# Data source mode
#
# live    — all sponsor calls hit the real Binance Web3 API. Requires credentials.
# fixture — all sponsor calls are served from committed, dated fixtures.
#
# There is NO automatic fallback from live to fixture. A live call that fails
# surfaces as an error. Fixture mode is visibly labelled in the UI.
# ---------------------------------------------------------------------------
TALOE_DATA_MODE=fixture
NEXT_PUBLIC_TALOE_DATA_MODE=fixture

# ---------------------------------------------------------------------------
# Chain configuration
# ---------------------------------------------------------------------------
# BNB Smart Chain mainnet. The product is mainnet-only per the hackathon rules.
TALOE_BINANCE_CHAIN_ID=56

# Independent BSC RPC used to verify execution results without relying solely
# on Binance's own success flag. Use your own provider endpoint.
TALOE_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# ---------------------------------------------------------------------------
# Routing policy (configurable, deliberately not buried in business logic)
# ---------------------------------------------------------------------------
# Safety margin: a quote is refused for the next operation when fewer than this
# many ms of its estimated lifetime remain. Documented lifetime is ~30s.
TALOE_QUOTE_MIN_REMAINING_MS=8000

# Default user constraint, in basis points, when the user does not set one.
# Provisional until the live liquidity campaign establishes a sane value.
TALOE_DEFAULT_MAX_DEVIATION_BPS=150
